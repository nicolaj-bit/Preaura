// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL. Adressen står i miljøvariablen DATABASE_URL (på Render sættes
// den selv ud fra databasen, se render.yaml).
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Indbakke for webhooks. Handlerne gemmer kun hændelsen her og kvitterer;
// selve behandlingen sker senere og asynkront. Dette er ikke appens
// forretningsdata — kun en kø.
model WebhookEvent {
  id          String    @id @default(cuid())
  // Shopifys X-Shopify-Webhook-Id. Unik, så en gentaget levering ikke
  // lægges i køen to gange.
  webhookId   String    @unique
  shop        String
  topic       String
  payload     String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  // "PENDING", "DONE", "FAILED" eller "SKIPPED" (emner, appen ikke behandler
  // endnu). FAILED vises i admin med mulighed for at prøve igen.
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
  @@index([shop, status])
}

// Sikrer, at kun én behandler arbejder på en butiks kø ad gangen, også hvis
// appen kører på flere servere. Låsen udløber af sig selv.
model QueueLock {
  shop        String   @id
  holder      String
  lockedUntil DateTime
}

// ---------------------------------------------------------------------------
// Forudbestilling
//
// Alle fire tabeller har en shop-kolonne. Al adgang går gennem
// app/models/preorder.server.ts, som altid filtrerer på shop. Læs og skriv
// aldrig disse tabeller direkte med `db` andre steder.
// ---------------------------------------------------------------------------

// Butiksindstilling. Én række pr. butik.
model ShopSetting {
  id                    String   @id @default(cuid())
  shop                  String   @unique
  // "SHIPPING" = vis som forventet afsendelse, "DELIVERY" = forventet levering.
  dateMode              String   @default("SHIPPING")
  buttonLabel           String   @default("Forudbestil")
  shippingDateText      String   @default("Forventet afsendelse: {dato}")
  deliveryDateText      String   @default("Forventet levering: {dato}")
  preorderNote          String   @default("Varen er på forudbestilling og sendes, når den er på lager.")
  // Venteliste: varen skal have kunnet købes i så mange minutter, før der
  // udløses (så et glimt i lageret ikke sender beskeder), og der udløses
  // højst waitlistBatchSize tilmeldinger hvert waitlistBatchMinutes minut.
  waitlistStableMinutes Int      @default(10)
  waitlistBatchSize     Int      @default(50)
  waitlistBatchMinutes  Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Variantplan. Én række pr. variant. Et produkt er slået til, hvis mindst én
// af dets varianter er det — det gemmes ikke, det regnes ud.
model VariantPlan {
  id                     String    @id @default(cuid())
  shop                   String
  productId              String
  variantId              String
  inventoryItemId        String
  // Lageret, varianten styres fra. Tom, hvis varen ikke ligger på noget lager.
  locationId             String?
  preorderEnabled        Boolean   @default(false)
  // Hvornår forudbestilling sidst blev slået til. Sikkerhedsnettet tæller
  // kun ordrer uden plan, der er oprettet efter dette tidspunkt — ellers ville
  // en gammel, almindelig ordre, der bliver rettet, pludselig tælle med.
  preorderEnabledAt      DateTime?
  // Sand, når appen har sat produktets requiresSellingPlan. Kun da må appen
  // slå det fra igen. Sættes på alle produktets rækker.
  setRequiresSellingPlan Boolean   @default(false)

  // Tilstand: "STOCK" (lagermode: appen rører hverken lager eller selling
  // plans) eller "PREORDER" (forudbestillingsmode: appen ejer lagertallet).
  // Appen skifter selv, se app/lib/variantMode.ts. Kun relevant, når
  // preorderEnabled er sand.
  mode                String    @default("STOCK")
  // Sand: webshopejeren har tvunget varianten i forudbestilling.
  modeForced          Boolean   @default(false)
  // Lageret, da tvangen blev slået til. Gives tilbage, når den slås fra.
  stockBeforeForce    Int?
  // Varer lagt på lager, mens varianten var tvunget. Gives tilbage (efter
  // forudbestillingerne), når tvangen slås fra.
  receivedWhileForced Int       @default(0)
  modeChangedAt       DateTime?
  modeChangeReason    String?

  // Synkronisering med Shopify. Udfyldes kun af app/sync/.
  // Variantens egen selling plan group i Shopify.
  sellingPlanGroupId String?
  // Seneste vellykkede synkronisering, og det lagerantal den efterlod.
  lastSyncedAt       DateTime?
  syncedAvailable    Int?
  // Seneste fejl. Tom, når seneste forsøg lykkedes. Vises i admin.
  lastSyncError      String?
  lastSyncAttemptAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, variantId])
  @@index([shop, productId])
}

// Leverance. Rækkefølgenummeret afgør, hvilken leverance der er aktiv: den
// første, der hverken er annulleret eller udsolgt.
//
// Resterende antal gemmes IKKE. Det er altid `quantity` minus summen af
// aktive tildelinger. Se app/lib/deliveries.ts.
model Delivery {
  id            String       @id @default(cuid())
  shop          String
  variantId     String
  position      Int
  // Kun dato, uden klokkeslæt og tidszone: "YYYY-MM-DD".
  date          String
  quantity      Int
  // "OPEN" eller "CANCELLED". "Udsolgt" og "aktiv" regnes ud.
  status        String       @default("OPEN")
  // Tom indtil selling plans kommer i opgave 3.
  sellingPlanId String?
  cancelledAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  allocations   Allocation[]

  @@unique([shop, variantId, position])
  @@index([shop, variantId])
}

// Tildeling: regnskabet over, hvem der har fået plads i hvilken leverance.
//
// Rækker slettes ALDRIG og ændres ikke i antal. Ændres en ordrelinjes antal,
// annulleres den gamle række, og en ny oprettes — så historikken kan læses.
//
// En ordrelinje kan fordeles over flere leverancer, når der ikke er plads i
// én. Derfor er den unikke nøgle: højst én AKTIV række pr. ordrelinje og
// leverance, og højst én UAFKLARET række pr. ordrelinje. Det er partielle
// unikke indekser, som Prisma ikke kan beskrive — de står i migrationen
// 20261104130000_init.
//
// onDelete: Restrict forhindrer også, at en leverance med tildelinger slettes.
model Allocation {
  id              String    @id @default(cuid())
  shop            String
  orderId         String
  // Ordrenummeret, som kunden og webshopejeren kender det, fx "#1042".
  orderName       String    @default("")
  // Hvornår kunden bestilte. Afgør rækkefølgen ved fordeling.
  orderCreatedAt  DateTime?
  orderLineId     String
  variantId       String
  // Tom for en uafklaret tildeling (ingen plads i nogen leverance).
  deliveryId      String?
  delivery        Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  quantity        Int
  // "ACTIVE", "UNRESOLVED" (ingen plads) eller "CANCELLED".
  status          String    @default("ACTIVE")
  // Sand, når ordrelinjen ikke havde en af appens selling plans (almindeligt
  // køb, kladdeordre, POS, API). Tælles alligevel — sikkerhedsnettet — men
  // vises samlet i admin, fordi det tit betyder, at opsætningen er forkert.
  soldWithoutPlan Boolean   @default(false)
  // Datoen, kunden blev lovet, da tildelingen blev lavet. Den følger IKKE
  // leverancen, hvis leverancens dato senere ændres.
  promisedDate    String?
  // Varerne til tildelingen er kommet hjem: klar til afsendelse.
  readyAt         DateTime?
  allocatedAt     DateTime  @default(now())
  cancelledAt     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([shop, deliveryId])
  @@index([shop, orderLineId])
  @@index([shop, orderId])
}

// Hvilken leverance en selling plan hører til. Skrives af synkroniseringen,
// hver gang en plan oprettes, og slettes aldrig — så en ordre på en plan, der
// siden er taget ud af brug, stadig kan føres tilbage til sin leverance.
model SellingPlanRef {
  shop          String
  sellingPlanId String
  deliveryId    String
  createdAt     DateTime @default(now())

  @@id([shop, sellingPlanId])
}

// Historik over tilstandsskift pr. variant. Slettes aldrig. Bruges til at
// vise, hvad der skete, og til at afgøre, hvilken tilstand en variant var i,
// da en ordre blev lagt (sikkerhedsnettet tæller kun salg i forudbestilling).
model ModeChange {
  id        String   @id @default(cuid())
  shop      String
  variantId String
  // "STOCK" eller "PREORDER".
  mode      String
  forced    Boolean  @default(false)
  reason    String
  at        DateTime @default(now())

  @@index([shop, variantId, at])
}

// En kundes anmodning om at se sine data (customers/data_request). Vises i
// admin, så webshopejeren kan sende oplysningerne videre til kunden.
// Slettes ved customers/redact og shop/redact, og 30 dage efter, den er
// besvaret.
model DataRequest {
  id               String    @id @default(cuid())
  shop             String
  // Shopifys id på kunden og på anmodningen. Ingen navne eller mails.
  customerId       String
  shopifyRequestId String?
  // JSON: ordre-id'erne, kunden spørger om.
  orderIds         String
  // JSON: det, PREAURA gemmer om de ordrer, da anmodningen kom.
  data             String
  // JSON: kundens tilmeldinger til ventelisten (produkt, variant, tidspunkt).
  waitlist         String    @default("[]")
  receivedAt       DateTime  @default(now())
  answeredAt       DateTime?

  @@index([shop, answeredAt])
  @@index([shop, customerId])
}

// ---------------------------------------------------------------------------
// Udgående hændelser (Flow, webhook, Klaviyo)
//
// Én hændelse bygges ét sted (app/events/build.ts) og sendes ens til alle
// modtagere. Al adgang går gennem app/models/outbox.server.ts.
// ---------------------------------------------------------------------------

// Webshopejerens opsætning af modtagere. Én række pr. butik. Nøgler og
// adresser gemmes krypteret (app/lib/crypto.server.ts) og læses aldrig
// tilbage i admin — kun de sidste fire tegn vises.
model IntegrationSetting {
  id                       String    @id @default(cuid())
  shop                     String    @unique
  flowEnabled              Boolean   @default(true)
  webhookEnabled           Boolean   @default(false)
  webhookUrlEnc            String?
  webhookUrlLast4          String?
  // Signaturnøglen til webhooken. Krypteret, men vises i admin, så
  // modtageren kan verificere kaldene.
  webhookSecretEnc         String?
  klaviyoEnabled           Boolean   @default(false)
  klaviyoKeyEnc            String?
  klaviyoKeyLast4          String?
  // Hvornår webshopejeren bekræftede at have grundlag for at sende
  // kundeoplysninger til tredjepart. Kræves for webhook og Klaviyo.
  responsibilityAcceptedAt DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// En hændelse. Oprettes i samme transaktion som ændringen, der udløser den
// (status NEW), og bygges bagefter med kundens navn og e-mail fra Shopify
// (status BUILT). id er hændelsens entydige id — også unique_id hos Klaviyo.
model OutboxEvent {
  id              String           @id
  shop            String
  // "preorder.created", "preorder.delayed", "preorder.ready",
  // "preorder.cancelled" eller "waitlist.available".
  type            String
  // Sikrer, at samme ændring kun giver én hændelse, uanset hvor mange gange
  // ordren eller leverancen behandles.
  dedupeKey       String
  // Tom for hændelser fra ventelisten, som ikke hører til en ordre.
  orderId         String?
  orderName       String           @default("")
  orderLineId     String?
  variantId       String
  quantity        Int
  deliveryDate    String?
  previousDate    String?
  // Venteliste: tilmeldingen, produktet og leverancen, der blev åbnet (tom,
  // når varen kom på lager). emailHash er en envejs-nøgle til kundens
  // e-mail, så hændelsen kan slettes på kundens anmodning.
  waitlistEntryId String?
  productId       String?
  deliveryId      String?
  emailHash       String?
  // "NEW", "BUILT" eller "FAILED" (kunne ikke bygges).
  status          String           @default("NEW")
  lastError       String?
  // Den byggede hændelse som krypteret JSON. Indeholder kundens navn og
  // e-mail. Slettes efter 30 dage og ved customers/redact.
  payloadEnc      String?
  createdAt       DateTime         @default(now())
  builtAt         DateTime?
  deliveries      OutboxDelivery[]

  @@unique([shop, dedupeKey])
  @@index([shop, status])
  @@index([shop, orderId])
  @@index([shop, createdAt])
  @@index([shop, emailHash])
}

// Én levering af en hændelse til én modtager. Genforsøg med voksende
// ventetid; fejler den endeligt, står den som FAILED i admin.
model OutboxDelivery {
  id            String      @id @default(cuid())
  shop          String
  eventId       String
  event         OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // "FLOW", "WEBHOOK" eller "KLAVIYO".
  channel       String
  // "PENDING", "DONE" eller "FAILED".
  status        String      @default("PENDING")
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lastError     String?
  lastStatus    Int?
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([eventId, channel])
  @@index([shop, status, nextAttemptAt])
  @@index([shop, createdAt])
}

// ---------------------------------------------------------------------------
// Venteliste («giv mig besked, når varen kan købes»)
//
// Én mekanisme med to udløsere: varen kommer på lager, eller en leverance med
// ledige pladser åbnes. Begge dele betyder, at varianten kan købes i Shopify.
// Al adgang går gennem app/models/waitlist.server.ts.
// ---------------------------------------------------------------------------

// Én tilmelding. Kun e-mail (krypteret), produkt, variant, butik og
// tidspunkt. emailHash er en envejs-nøgle (HMAC), så samme e-mail ikke står
// to gange på samme variant, og så kundens tilmeldinger kan findes og slettes
// på kundens anmodning — uden at e-mailen skal kunne læses.
//
// En udløst tilmelding (notifiedAt sat) er lukket og udløses aldrig igen.
// Højst én ÅBEN tilmelding pr. e-mail og variant: partielt unikt indeks i
// migrationen 20261106100000_waitlist.
//
// Slettes af sig selv: åbne efter 180 dage, udløste 7 dage efter udløsning.
model WaitlistEntry {
  id         String    @id @default(cuid())
  shop       String
  productId  String
  variantId  String
  emailEnc   String
  emailHash  String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@index([shop, variantId, notifiedAt, createdAt])
  @@index([shop, emailHash])
  @@index([notifiedAt])
  @@index([createdAt])
}

// Tilstand pr. variant med ventende tilmeldinger. Ingen persondata.
// availableSince: hvornår varianten sidst blev købbar (null = kan ikke
// købes). lastBatchAt: hvornår sidste portion blev udløst.
model WaitlistWatch {
  shop           String
  variantId      String
  availableSince DateTime?
  lastBatchAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@id([shop, variantId])
}

// Hvor mange der har fået besked pr. variant og leverance. Kun tal, ingen
// persondata — bliver stående, når tilmeldingerne slettes, så butikken kan
// se efterspørgslen. deliveryId er tom, når varen kom på lager.
model WaitlistStat {
  shop         String
  variantId    String
  productId    String
  deliveryId   String   @default("")
  deliveryDate String?
  notified     Int      @default(0)
  lastAt       DateTime @default(now())

  @@id([shop, variantId, deliveryId])
}
