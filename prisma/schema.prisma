// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Indbakke for webhooks. Handlerne gemmer kun hændelsen her og kvitterer;
// selve behandlingen sker senere og asynkront. Dette er ikke appens
// forretningsdata — kun en kø.
model WebhookEvent {
  id          String    @id @default(cuid())
  // Shopifys X-Shopify-Webhook-Id. Unik, så en gentaget levering ikke
  // lægges i køen to gange.
  webhookId   String    @unique
  shop        String
  topic       String
  payload     String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  // "PENDING", "DONE", "FAILED" eller "SKIPPED" (emner, appen ikke behandler
  // endnu). FAILED vises i admin med mulighed for at prøve igen.
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?

  @@index([processedAt, receivedAt])
  @@index([shop, status])
}

// Sikrer, at kun én behandler arbejder på en butiks kø ad gangen, også hvis
// appen kører på flere servere. Låsen udløber af sig selv.
model QueueLock {
  shop        String   @id
  holder      String
  lockedUntil DateTime
}

// ---------------------------------------------------------------------------
// Forudbestilling
//
// Alle fire tabeller har en shop-kolonne. Al adgang går gennem
// app/models/preorder.server.ts, som altid filtrerer på shop. Læs og skriv
// aldrig disse tabeller direkte med `db` andre steder.
// ---------------------------------------------------------------------------

// Butiksindstilling. Én række pr. butik.
model ShopSetting {
  id               String   @id @default(cuid())
  shop             String   @unique
  // "SHIPPING" = vis som forventet afsendelse, "DELIVERY" = forventet levering.
  dateMode         String   @default("SHIPPING")
  buttonLabel      String   @default("Forudbestil")
  shippingDateText String   @default("Forventet afsendelse: {dato}")
  deliveryDateText String   @default("Forventet levering: {dato}")
  preorderNote     String   @default("Varen er på forudbestilling og sendes, når den er på lager.")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Variantplan. Én række pr. variant. Et produkt er slået til, hvis mindst én
// af dets varianter er det — det gemmes ikke, det regnes ud.
model VariantPlan {
  id              String   @id @default(cuid())
  shop            String
  productId       String
  variantId       String
  inventoryItemId String
  // Lageret, varianten styres fra. Tom, hvis varen ikke ligger på noget lager.
  locationId      String?
  preorderEnabled Boolean  @default(false)
  // Hvornår forudbestilling sidst blev slået til. Sikkerhedsnettet tæller
  // kun ordrer uden plan, der er oprettet efter dette tidspunkt — ellers ville
  // en gammel, almindelig ordre, der bliver rettet, pludselig tælle med.
  preorderEnabledAt DateTime?
  // Sand, når appen har sat produktets requiresSellingPlan. Kun da må appen
  // slå det fra igen. Sættes på alle produktets rækker.
  setRequiresSellingPlan Boolean @default(false)

  // Synkronisering med Shopify. Udfyldes kun af app/sync/.
  // Variantens egen selling plan group i Shopify.
  sellingPlanGroupId String?
  // Seneste vellykkede synkronisering, og det lagerantal den efterlod.
  lastSyncedAt       DateTime?
  syncedAvailable    Int?
  // Seneste fejl. Tom, når seneste forsøg lykkedes. Vises i admin.
  lastSyncError      String?
  lastSyncAttemptAt  DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, variantId])
  @@index([shop, productId])
}

// Leverance. Rækkefølgenummeret afgør, hvilken leverance der er aktiv: den
// første, der hverken er annulleret eller udsolgt.
//
// Resterende antal gemmes IKKE. Det er altid `quantity` minus summen af
// aktive tildelinger. Se app/lib/deliveries.ts.
model Delivery {
  id            String       @id @default(cuid())
  shop          String
  variantId     String
  position      Int
  // Kun dato, uden klokkeslæt og tidszone: "YYYY-MM-DD".
  date          String
  quantity      Int
  // "OPEN" eller "CANCELLED". "Udsolgt" og "aktiv" regnes ud.
  status        String       @default("OPEN")
  // Tom indtil selling plans kommer i opgave 3.
  sellingPlanId String?
  cancelledAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  allocations   Allocation[]

  @@unique([shop, variantId, position])
  @@index([shop, variantId])
}

// Tildeling: regnskabet over, hvem der har fået plads i hvilken leverance.
//
// Rækker slettes ALDRIG og ændres ikke i antal. Ændres en ordrelinjes antal,
// annulleres den gamle række, og en ny oprettes — så historikken kan læses.
//
// En ordrelinje kan fordeles over flere leverancer, når der ikke er plads i
// én. Derfor er den unikke nøgle: højst én AKTIV række pr. ordrelinje og
// leverance, og højst én UAFKLARET række pr. ordrelinje. Det er partielle
// unikke indekser, som Prisma ikke kan beskrive — de står i migrationen
// 2026..._order_processing.
//
// onDelete: Restrict forhindrer også, at en leverance med tildelinger slettes.
model Allocation {
  id             String    @id @default(cuid())
  shop           String
  orderId        String
  // Ordrenummeret, som kunden og webshopejeren kender det, fx "#1042".
  orderName      String    @default("")
  // Hvornår kunden bestilte. Afgør rækkefølgen ved fordeling.
  orderCreatedAt DateTime?
  orderLineId    String
  variantId      String
  // Tom for en uafklaret tildeling (ingen plads i nogen leverance).
  deliveryId     String?
  delivery       Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  quantity       Int
  // "ACTIVE", "UNRESOLVED" (ingen plads) eller "CANCELLED".
  status         String    @default("ACTIVE")
  // Sand, når ordrelinjen ikke havde en af appens selling plans (almindeligt
  // køb, kladdeordre, POS, API). Tælles alligevel — sikkerhedsnettet — men
  // vises samlet i admin, fordi det tit betyder, at opsætningen er forkert.
  soldWithoutPlan Boolean   @default(false)
  // Datoen, kunden blev lovet, da tildelingen blev lavet. Den følger IKKE
  // leverancen, hvis leverancens dato senere ændres.
  promisedDate   String?
  allocatedAt    DateTime  @default(now())
  cancelledAt    DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([shop, deliveryId])
  @@index([shop, orderLineId])
  @@index([shop, orderId])
}

// Hvilken leverance en selling plan hører til. Skrives af synkroniseringen,
// hver gang en plan oprettes, og slettes aldrig — så en ordre på en plan, der
// siden er taget ud af brug, stadig kan føres tilbage til sin leverance.
model SellingPlanRef {
  shop          String
  sellingPlanId String
  deliveryId    String
  createdAt     DateTime @default(now())

  @@id([shop, sellingPlanId])
}
