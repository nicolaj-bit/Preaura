{%- comment -%}
  PREAURA – forudbestilling på produktsiden.

  Læser variantens metafelt preaura.preorder (skrevet af appens
  synkronisering) for ALLE varianter ved sideindlæsning. Intet netværkskald
  fra produktsiden: siden bliver ikke langsommere og afhænger ikke af, at
  appens server svarer.

  JavaScript (assets/preaura-preorder.js) lægger to skjulte felter i temaets
  produktformular — selling_plan og en synlig linjeegenskab med datoen — og
  holder dem opdateret ved variantskifte. Ellers røres temaet ikke.

  Ventelisten: kan varianten hverken købes på lager eller forudbestilles,
  vises et felt til e-mail (hvis det er slået til). Tilmeldingen sendes til
  appen gennem Shopifys app-proxy (/apps/preaura/waitlist). Feltet gælder
  KUN besked om varen — ingen nyhedsbrev, og ingen afkrydsningsfelter.

  Resttal og tidslinje: hentes EFTER sideindlæsning fra appen gennem
  app-proxyen (/apps/preaura/availability) i ét lille kald, så tallet er
  friskt, selv om produktsiden er cachet, og siden ikke venter på det. Uden
  svar vises hverken tal eller tidslinje.

  Ingen skrifttyper, størrelser eller farver: alt arver temaets udseende.
  Tidslinjen har kun struktur (en linje i tekstens egen farve og afstand).
  Knappen får temaets almindelige knap-klasse («button»), hvis temaet har en.
{%- endcomment -%}
{%- liquid
  assign preaura_product = closest.product | default: product
-%}
{%- if preaura_product -%}
{%- liquid
  # Tekster: butikkens egen tekst, ellers standardteksten på kundens sprog
  # (locales/*.json).
  assign preaura_d_shipping_label = 'preorder.shipping_label' | t
  assign preaura_d_delivery_label = 'preorder.delivery_label' | t
  assign preaura_d_message = 'preorder.message' | t
  assign preaura_d_note = 'preorder.note' | t
  assign preaura_d_sold_out_message = 'preorder.sold_out_message' | t
  assign preaura_d_button_text = 'preorder.button_text' | t
  assign preaura_d_remaining_text = 'preorder.remaining_text' | t
  assign preaura_d_timeline_sold_out = 'preorder.timeline_sold_out' | t
  assign preaura_d_timeline_current = 'preorder.timeline_current' | t
  assign preaura_d_timeline_upcoming = 'preorder.timeline_upcoming' | t
  assign preaura_d_waitlist_heading = 'preorder.waitlist_heading' | t
  assign preaura_d_waitlist_email_label = 'preorder.waitlist_email_label' | t
  assign preaura_d_waitlist_button = 'preorder.waitlist_button' | t
  assign preaura_d_waitlist_success = 'preorder.waitlist_success' | t
  assign preaura_d_waitlist_invalid = 'preorder.waitlist_invalid' | t
  assign preaura_d_waitlist_error = 'preorder.waitlist_error' | t
  assign preaura_d_waitlist_privacy = 'preorder.waitlist_privacy' | t
  assign preaura_t_shipping_label = block.settings.shipping_label | default: preaura_d_shipping_label
  assign preaura_t_delivery_label = block.settings.delivery_label | default: preaura_d_delivery_label
  assign preaura_t_message = block.settings.message | default: preaura_d_message
  assign preaura_t_note = block.settings.note | default: preaura_d_note
  assign preaura_t_sold_out_message = block.settings.sold_out_message | default: preaura_d_sold_out_message
  assign preaura_t_button_text = block.settings.button_text | default: preaura_d_button_text
  assign preaura_t_remaining_text = block.settings.remaining_text | default: preaura_d_remaining_text
  assign preaura_t_timeline_sold_out = block.settings.timeline_sold_out | default: preaura_d_timeline_sold_out
  assign preaura_t_timeline_current = block.settings.timeline_current | default: preaura_d_timeline_current
  assign preaura_t_timeline_upcoming = block.settings.timeline_upcoming | default: preaura_d_timeline_upcoming
  assign preaura_t_waitlist_heading = block.settings.waitlist_heading | default: preaura_d_waitlist_heading
  assign preaura_t_waitlist_email_label = block.settings.waitlist_email_label | default: preaura_d_waitlist_email_label
  assign preaura_t_waitlist_button = block.settings.waitlist_button | default: preaura_d_waitlist_button
  assign preaura_t_waitlist_success = block.settings.waitlist_success | default: preaura_d_waitlist_success
  assign preaura_t_waitlist_invalid = block.settings.waitlist_invalid | default: preaura_d_waitlist_invalid
  assign preaura_t_waitlist_error = block.settings.waitlist_error | default: preaura_d_waitlist_error
  assign preaura_t_waitlist_privacy = block.settings.waitlist_privacy | default: preaura_d_waitlist_privacy
-%}
  <style>
    .preaura{display:flex;flex-direction:column;gap:.75em;margin:1.25em 0;padding:1.1em 1.25em;border:1px solid;border-color:color-mix(in srgb,currentColor 18%,transparent);border-radius:.6em}
    .preaura--plain{padding:0;border:0;border-radius:0}
    .preaura[hidden],.preaura [hidden]{display:none!important}
    .preaura p{margin:0}
    .preaura__message{font-weight:600}
    .preaura__remaining{display:flex;align-items:center;gap:.5em}
    .preaura__remaining::before{content:"";flex:none;width:.5em;height:.5em;border-radius:50%;background:currentColor}
    .preaura__note{font-size:.875em;opacity:.75}
    .preaura__timeline{padding-top:.85em;border-top:1px solid;border-color:color-mix(in srgb,currentColor 12%,transparent)}
    .preaura__timeline-heading{margin-bottom:.7em!important;font-size:.75em;letter-spacing:.08em;text-transform:uppercase;opacity:.7}
    .preaura__timeline ol{list-style:none;margin:0;padding:0}
    .preaura__timeline li{position:relative;display:flex;justify-content:space-between;gap:1em;padding:0 0 .75em 1.6em}
    .preaura__timeline li:last-child{padding-bottom:0}
    .preaura__timeline li::before{content:"";position:absolute;left:0;top:.4em;width:.65em;height:.65em;box-sizing:border-box;border:1.5px solid currentColor;border-radius:50%}
    .preaura__timeline li::after{content:"";position:absolute;left:.3em;top:1.25em;bottom:.15em;width:1px;background:currentColor;opacity:.25}
    .preaura__timeline li:last-child::after{display:none}
    .preaura__timeline li[data-state=CURRENT]{font-weight:600}
    .preaura__timeline li[data-state=CURRENT]::before{background:currentColor}
    .preaura__timeline li[data-state=SOLD_OUT]{opacity:.5}
    .preaura__timeline li[data-state=SOLD_OUT] .preaura__date{text-decoration:line-through}
    .preaura__date{white-space:nowrap}
    .preaura__state{text-align:right;opacity:.8}
    .preaura__sep{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .preaura__waitlist{display:flex;flex-direction:column;gap:.6em}
    .preaura__waitlist-heading{font-weight:600}
    .preaura__label{font-size:.875em;opacity:.8}
    .preaura__input{box-sizing:border-box;width:100%;padding:.75em 1em;font:inherit;color:inherit;background:transparent;border:1px solid;border-color:color-mix(in srgb,currentColor 35%,transparent);border-radius:.4em}
    .preaura__input:focus{outline:2px solid currentColor;outline-offset:1px}
    .preaura__submit{width:100%}
    .preaura__status:empty{display:none}
    .preaura__privacy{font-size:.8em;opacity:.7}
  </style>
  <div class="preaura{% unless block.settings.boxed %} preaura--plain{% endunless %}" data-preaura-root hidden {{ block.shopify_attributes }}>
    <p class="preaura__message" data-preaura-message></p>
    <p class="preaura__remaining" data-preaura-remaining hidden></p>
    {%- if block.settings.show_timeline -%}
      {%- assign preaura_timeline_id = 'preaura-timeline-' | append: block.id -%}
      <div class="preaura__timeline" data-preaura-timeline hidden>
        <p class="preaura__timeline-heading" id="{{ preaura_timeline_id }}" data-preaura-timeline-heading></p>
        <ol aria-labelledby="{{ preaura_timeline_id }}" data-preaura-timeline-list></ol>
      </div>
    {%- endif -%}
    {%- if block.settings.show_note -%}
      <p class="preaura__note" data-preaura-note>{{ preaura_t_note | escape }}</p>
    {%- endif -%}
    {%- if block.settings.waitlist_enabled -%}
      {%- assign preaura_field_id = 'preaura-waitlist-email-' | append: block.id -%}
      <div class="preaura__waitlist" data-preaura-waitlist hidden>
        <p class="preaura__waitlist-heading">{{ preaura_t_waitlist_heading | escape }}</p>
        <label class="preaura__label" for="{{ preaura_field_id }}">{{ preaura_t_waitlist_email_label | escape }}</label>
        <input
          class="preaura__input"
          id="{{ preaura_field_id }}"
          type="email"
          name="email"
          autocomplete="email"
          inputmode="email"
          maxlength="254"
          required
          data-preaura-waitlist-email
        >
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden data-preaura-waitlist-trap>
        <button type="button" class="button preaura__submit" data-preaura-waitlist-submit>
          {{- preaura_t_waitlist_button | escape -}}
        </button>
        <p class="preaura__status" role="status" aria-live="polite" data-preaura-waitlist-status></p>
        <p class="preaura__privacy">{{ preaura_t_waitlist_privacy | escape }}</p>
      </div>
    {%- endif -%}
    <script type="application/json" data-preaura-data>
      {
        "selected": {{ preaura_product.selected_or_first_available_variant.id | json }},
        "product": {{ preaura_product.id | json }},
        "extras": {{ 'preaura-preorder-extras.js' | asset_url | json }},
        "locale": {{ request.locale.iso_code | json }},
        "settings": {
          "shippingLabel": {{ preaura_t_shipping_label | json }},
          "deliveryLabel": {{ preaura_t_delivery_label | json }},
          "message": {{ preaura_t_message | json }},
          "soldOutMessage": {{ preaura_t_sold_out_message | json }},
          "changeButtonText": {{ block.settings.change_button_text | json }},
          "buttonText": {{ preaura_t_button_text | json }},
          "showRemaining": {{ block.settings.show_remaining | json }},
          "remainingThreshold": {{ block.settings.remaining_threshold | json }},
          "remainingText": {{ preaura_t_remaining_text | json }},
          "timeline": {{ block.settings.show_timeline | json }},
          "timelineSoldOut": {{ preaura_t_timeline_sold_out | json }},
          "timelineCurrent": {{ preaura_t_timeline_current | json }},
          "timelineUpcoming": {{ preaura_t_timeline_upcoming | json }},
          "waitlist": {{ block.settings.waitlist_enabled | json }},
          "waitlistSuccess": {{ preaura_t_waitlist_success | json }},
          "waitlistError": {{ preaura_t_waitlist_error | json }},
          "waitlistInvalid": {{ preaura_t_waitlist_invalid | json }}
        },
        "available": {
          {%- for variant in preaura_product.variants -%}
            "{{ variant.id }}": {{ variant.available | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        },
        "variants": {
          {%- for variant in preaura_product.variants -%}
            "{{ variant.id }}": {{ variant.metafields.preaura.preorder.value | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      }
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:preorder.name",
  "target": "content",
  "javascript": "preaura-preorder.js",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:preorder.settings.intro.content"
    },
    {
      "type": "paragraph",
      "content": "t:preorder.settings.texts_info.content"
    },
    {
      "type": "checkbox",
      "id": "boxed",
      "label": "t:preorder.settings.boxed.label",
      "info": "t:preorder.settings.boxed.info",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "t:preorder.settings.shipping_label.label",
      "placeholder": "t:preorder.settings.shipping_label.placeholder",
      "info": "t:preorder.settings.shipping_label.info"
    },
    {
      "type": "text",
      "id": "delivery_label",
      "label": "t:preorder.settings.delivery_label.label",
      "placeholder": "t:preorder.settings.delivery_label.placeholder",
      "info": "t:preorder.settings.delivery_label.info"
    },
    {
      "type": "text",
      "id": "message",
      "label": "t:preorder.settings.message.label",
      "placeholder": "t:preorder.settings.message.placeholder",
      "info": "t:preorder.settings.message.info"
    },
    {
      "type": "checkbox",
      "id": "show_note",
      "label": "t:preorder.settings.show_note.label",
      "default": true
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "t:preorder.settings.note.label",
      "placeholder": "t:preorder.settings.note.placeholder",
      "info": "t:preorder.settings.note.info"
    },
    {
      "type": "text",
      "id": "sold_out_message",
      "label": "t:preorder.settings.sold_out_message.label",
      "placeholder": "t:preorder.settings.sold_out_message.placeholder",
      "info": "t:preorder.settings.sold_out_message.info"
    },
    {
      "type": "checkbox",
      "id": "change_button_text",
      "label": "t:preorder.settings.change_button_text.label",
      "info": "t:preorder.settings.change_button_text.info",
      "default": false
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:preorder.settings.button_text.label",
      "placeholder": "t:preorder.settings.button_text.placeholder",
      "info": "t:preorder.settings.button_text.info"
    },
    {
      "type": "header",
      "content": "t:preorder.settings.remaining_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_remaining",
      "label": "t:preorder.settings.show_remaining.label",
      "info": "t:preorder.settings.show_remaining.info",
      "default": true
    },
    {
      "type": "number",
      "id": "remaining_threshold",
      "label": "t:preorder.settings.remaining_threshold.label",
      "info": "t:preorder.settings.remaining_threshold.info",
      "default": 25
    },
    {
      "type": "text",
      "id": "remaining_text",
      "label": "t:preorder.settings.remaining_text.label",
      "placeholder": "t:preorder.settings.remaining_text.placeholder",
      "info": "t:preorder.settings.remaining_text.info"
    },
    {
      "type": "header",
      "content": "t:preorder.settings.timeline_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_timeline",
      "label": "t:preorder.settings.show_timeline.label",
      "info": "t:preorder.settings.show_timeline.info",
      "default": true
    },
    {
      "type": "text",
      "id": "timeline_sold_out",
      "label": "t:preorder.settings.timeline_sold_out.label",
      "placeholder": "t:preorder.settings.timeline_sold_out.placeholder"
    },
    {
      "type": "text",
      "id": "timeline_current",
      "label": "t:preorder.settings.timeline_current.label",
      "placeholder": "t:preorder.settings.timeline_current.placeholder",
      "info": "t:preorder.settings.timeline_current.info"
    },
    {
      "type": "text",
      "id": "timeline_upcoming",
      "label": "t:preorder.settings.timeline_upcoming.label",
      "placeholder": "t:preorder.settings.timeline_upcoming.placeholder"
    },
    {
      "type": "header",
      "content": "t:preorder.settings.waitlist_header.content"
    },
    {
      "type": "paragraph",
      "content": "t:preorder.settings.waitlist_intro.content"
    },
    {
      "type": "checkbox",
      "id": "waitlist_enabled",
      "label": "t:preorder.settings.waitlist_enabled.label",
      "default": false
    },
    {
      "type": "text",
      "id": "waitlist_heading",
      "label": "t:preorder.settings.waitlist_heading.label",
      "placeholder": "t:preorder.settings.waitlist_heading.placeholder"
    },
    {
      "type": "text",
      "id": "waitlist_email_label",
      "label": "t:preorder.settings.waitlist_email_label.label",
      "placeholder": "t:preorder.settings.waitlist_email_label.placeholder"
    },
    {
      "type": "text",
      "id": "waitlist_button",
      "label": "t:preorder.settings.waitlist_button.label",
      "placeholder": "t:preorder.settings.waitlist_button.placeholder"
    },
    {
      "type": "text",
      "id": "waitlist_success",
      "label": "t:preorder.settings.waitlist_success.label",
      "placeholder": "t:preorder.settings.waitlist_success.placeholder",
      "info": "t:preorder.settings.waitlist_success.info"
    },
    {
      "type": "text",
      "id": "waitlist_invalid",
      "label": "t:preorder.settings.waitlist_invalid.label",
      "placeholder": "t:preorder.settings.waitlist_invalid.placeholder"
    },
    {
