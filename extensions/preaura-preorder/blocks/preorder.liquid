{%- comment -%}
  PREAURA – forudbestilling på produktsiden.

  Læser variantens metafelt preaura.preorder (skrevet af appens
  synkronisering) for ALLE varianter ved sideindlæsning. Intet netværkskald
  fra produktsiden: siden bliver ikke langsommere og afhænger ikke af, at
  appens server svarer.

  JavaScript (assets/preaura-preorder.js) lægger to skjulte felter i temaets
  produktformular — selling_plan og en synlig linjeegenskab med datoen — og
  holder dem opdateret ved variantskifte. Ellers røres temaet ikke.

  Ventelisten: kan varianten hverken købes på lager eller forudbestilles,
  vises et felt til e-mail (hvis det er slået til). Tilmeldingen sendes til
  appen gennem Shopifys app-proxy (/apps/preaura/waitlist). Feltet gælder
  KUN besked om varen — ingen nyhedsbrev, og ingen afkrydsningsfelter.

  Resttal og tidslinje: hentes EFTER sideindlæsning fra appen gennem
  app-proxyen (/apps/preaura/availability) i ét lille kald, så tallet er
  friskt, selv om produktsiden er cachet, og siden ikke venter på det. Uden
  svar vises hverken tal eller tidslinje.

  Ingen skrifttyper, størrelser eller farver: alt arver temaets udseende.
  Tidslinjen har kun struktur (en linje i tekstens egen farve og afstand).
  Knappen får temaets almindelige knap-klasse («button»), hvis temaet har en.
{%- endcomment -%}
{%- liquid
  assign preaura_product = closest.product | default: product
-%}
{%- if preaura_product -%}
  <div data-preaura-root hidden {{ block.shopify_attributes }}>
    <p data-preaura-message></p>
    <p data-preaura-remaining hidden></p>
    {%- if block.settings.note != blank -%}
      <p data-preaura-note>{{ block.settings.note | escape }}</p>
    {%- endif -%}
    {%- if block.settings.show_timeline -%}
      {%- assign preaura_timeline_id = 'preaura-timeline-' | append: block.id -%}
      <style>
        [data-preaura-timeline] ol { list-style: none; margin: 0; padding: 0 0 0 1em; border-left: 1px solid currentColor; }
        [data-preaura-timeline] li { margin: 0 0 0.5em; }
      </style>
      <div data-preaura-timeline hidden>
        <p id="{{ preaura_timeline_id }}" data-preaura-timeline-heading></p>
        <ol aria-labelledby="{{ preaura_timeline_id }}" data-preaura-timeline-list></ol>
      </div>
    {%- endif -%}
    {%- if block.settings.waitlist_enabled -%}
      {%- assign preaura_field_id = 'preaura-waitlist-email-' | append: block.id -%}
      <div data-preaura-waitlist hidden>
        {%- if block.settings.waitlist_heading != blank -%}
          <p>{{ block.settings.waitlist_heading | escape }}</p>
        {%- endif -%}
        <label for="{{ preaura_field_id }}">{{ block.settings.waitlist_email_label | escape }}</label>
        <input
          id="{{ preaura_field_id }}"
          type="email"
          name="email"
          autocomplete="email"
          inputmode="email"
          maxlength="254"
          required
          data-preaura-waitlist-email
        >
        <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" hidden data-preaura-waitlist-trap>
        <button type="button" class="button" data-preaura-waitlist-submit>
          {{- block.settings.waitlist_button | escape -}}
        </button>
        <p role="status" aria-live="polite" data-preaura-waitlist-status></p>
        {%- if block.settings.waitlist_privacy != blank -%}
          <p>{{ block.settings.waitlist_privacy | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <script type="application/json" data-preaura-data>
      {
        "selected": {{ preaura_product.selected_or_first_available_variant.id | json }},
        "product": {{ preaura_product.id | json }},
        "locale": {{ request.locale.iso_code | json }},
        "settings": {
          "shippingLabel": {{ block.settings.shipping_label | json }},
          "deliveryLabel": {{ block.settings.delivery_label | json }},
          "message": {{ block.settings.message | json }},
          "soldOutMessage": {{ block.settings.sold_out_message | json }},
          "changeButtonText": {{ block.settings.change_button_text | json }},
          "buttonText": {{ block.settings.button_text | json }},
          "showRemaining": {{ block.settings.show_remaining | json }},
          "remainingThreshold": {{ block.settings.remaining_threshold | json }},
          "remainingText": {{ block.settings.remaining_text | json }},
          "timeline": {{ block.settings.show_timeline | json }},
          "timelineSoldOut": {{ block.settings.timeline_sold_out | json }},
          "timelineCurrent": {{ block.settings.timeline_current | json }},
          "timelineUpcoming": {{ block.settings.timeline_upcoming | json }},
          "waitlist": {{ block.settings.waitlist_enabled | json }},
          "waitlistSuccess": {{ block.settings.waitlist_success | json }},
          "waitlistError": {{ block.settings.waitlist_error | json }},
          "waitlistInvalid": {{ block.settings.waitlist_invalid | json }}
        },
        "available": {
          {%- for variant in preaura_product.variants -%}
            "{{ variant.id }}": {{ variant.available | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        },
        "variants": {
          {%- for variant in preaura_product.variants -%}
            "{{ variant.id }}": {{ variant.metafields.preaura.preorder.value | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      }
    </script>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Forudbestilling",
  "target": "content",
  "javascript": "preaura-preorder.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Placér blokken i produktsektionen, gerne lige over købsknappen. Datoen og teksterne vises kun for varianter på forudbestilling."
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Navn for forventet afsendelse",
      "info": "Vises i beskeden og som linjeegenskab i kurv, checkout, ordrebekræftelse og på ordren.",
      "default": "Forventet afsendelse"
    },
    {
      "type": "text",
      "id": "delivery_label",
      "label": "Navn for forventet levering",
      "info": "Bruges, når appens indstilling står til forventet levering.",
      "default": "Forventet levering"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Besked",
      "info": "{label} bliver til navnet ovenfor, {dato} til leverancens dato.",
      "default": "{label}: {dato}"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Forklaring",
      "info": "Gør vilkårene tydelige før køb. Lad feltet stå tomt for at skjule det.",
      "default": "Varen er på forudbestilling. Du betaler først, når varen sendes."
    },
    {
      "type": "text",
      "id": "sold_out_message",
      "label": "Besked, når alt er udsolgt",
      "default": "Udsolgt – alle leverancer er udsolgt."
    },
    {
      "type": "checkbox",
      "id": "change_button_text",
      "label": "Skift teksten på købsknappen",
      "info": "Slået fra: blokken viser sin egen besked over knappen, og temaets knap røres ikke.",
      "default": false
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Tekst på købsknappen",
      "default": "Forudbestil"
    },
    {
      "type": "header",
      "content": "Antal tilbage"
    },
    {
      "type": "checkbox",
      "id": "show_remaining",
      "label": "Vis antal tilbage i den aktuelle leverance",
      "info": "Tallet hentes frisk fra appen, når siden er indlæst. Det er altid antallet i den leverance, kunden køber ind i nu.",
      "default": true
    },
    {
      "type": "number",
      "id": "remaining_threshold",
      "label": "Vis først tallet, når der er højst",
      "info": "Fx 25: «Kun 480 tilbage» skaber ingen hast — det er bare støj.",
      "default": 25
    },
    {
      "type": "text",
      "id": "remaining_text",
      "label": "Tekst",
      "info": "{antal} bliver til antallet.",
      "default": "Kun {antal} tilbage i denne leverance."
    },
    {
      "type": "header",
      "content": "Tidslinje"
    },
    {
      "type": "checkbox",
      "id": "show_timeline",
      "label": "Vis tidslinje over leverancerne",
      "info": "Viser den aktuelle plan med forventede datoer og om hver leverance er udsolgt, den man køber ind i nu, eller kommende. Ingen antal pr. leverance.",
      "default": true
    },
    {
      "type": "text",
      "id": "timeline_sold_out",
      "label": "Udsolgt leverance",
      "default": "udsolgt"
    },
    {
      "type": "text",
      "id": "timeline_current",
      "label": "Leverancen, kunden køber ind i nu",
      "default": "du køber ind i denne leverance"
    },
    {
      "type": "text",
      "id": "timeline_upcoming",
      "label": "Kommende leverance",
      "default": "kommende"
    },
    {
      "type": "header",
      "content": "Venteliste"
    },
    {
      "type": "paragraph",
      "content": "Kan varianten hverken købes på lager eller forudbestilles, kan kunden skrive sig op og få besked, når den kan købes. Beskeden sendes som hændelse til Shopify Flow, Klaviyo eller din webhook. Den må kun handle om varen — tilbud, andre varer og rabatkoder kræver samtykke."
    },
    {
      "type": "checkbox",
      "id": "waitlist_enabled",
      "label": "Vis tilmelding til venteliste",
      "default": false
    },
    {
      "type": "text",
      "id": "waitlist_heading",
      "label": "Overskrift",
      "default": "Få besked, når varen kan købes"
    },
    {
      "type": "text",
      "id": "waitlist_email_label",
      "label": "Navn på feltet",
      "default": "Din e-mail"
    },
    {
      "type": "text",
      "id": "waitlist_button",
      "label": "Tekst på knappen",
      "default": "Giv mig besked"
    },
    {
      "type": "text",
      "id": "waitlist_success",
      "label": "Svar efter tilmelding",
      "info": "Vises altid efter en tilmelding — også hvis e-mailen allerede stod på listen.",
      "default": "Tak. Vi giver dig besked, når varen kan købes."
    },
    {
      "type": "text",
      "id": "waitlist_invalid",
      "label": "Svar ved ugyldig e-mail",
      "default": "Skriv en gyldig e-mail."
    },
    {
      "type": "text",
      "id": "waitlist_error",
      "label": "Svar ved fejl",
      "default": "Det lykkedes ikke. Prøv igen om lidt."
    },
    {
      "type": "textarea",
      "id": "waitlist_privacy",
      "label": "Oplysning om brug af e-mail",
      "default": "Vi bruger kun din e-mail til at give dig besked om denne vare. Du bliver ikke tilmeldt vores nyhedsbrev."
    }
  ]
}
{% endschema %}
